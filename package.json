{
  "name": "@toddkingham/mintml",
  "version": "0.1.5",
  "description": "The HTML-first, zero-build, single-page, client-side application, micro-framework. Extends standard HTML instead of replacing it — routing, templating, and role-based visibility that get out of the way. Remove `new MinTML()` and your page still works.",
  "type": "module",
  "main": "public/mintml.js",
  "module": "public/mintml.js",
  "exports": "./public/mintml.js",
  "unpkg": "public/mintml.min.js",
  "jsdelivr": "public/mintml.min.js",
  "files": [
    "public/mintml.js",
    "public/mintml.min.js"
  ],
  "scripts": {
    "build": "esbuild public/mintml.js --minify --format=esm --outfile=public/mintml.min.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "keywords": [
    "html",
    "html-first",
    "micro-framework",
    "vanilla-js",
    "semantic-html",
    "progressive-enhancement",
    "router",
    "spa",
    "templating",
    "zero-build",
    "no-build",
    "standards"
  ],
  "author": "Todd Kingham",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToddKingham/MinTML.git"
  },
  "homepage": "https://github.com/ToddKingham/MinTML#readme",
  "bugs": {
    "url": "https://github.com/ToddKingham/MinTML/issues"
  }
}
